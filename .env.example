# ── Lead delivery ────────────────────────────────────────────────────────────
# Until all three are set, /api/angebot returns 503 with reason "unconfigured"
# and the form falls back to a prefilled WhatsApp message. Nothing breaks; the
# lead just travels a different way.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where leads land. Must be a mailbox someone actually reads.
LEAD_TO_EMAIL=

# Must be on a domain verified in Resend, e.g. website@ga-hausmeisterservice.de
LEAD_FROM_EMAIL=
